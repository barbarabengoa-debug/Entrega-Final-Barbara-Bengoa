                            "mapper": {
                                "limit": 100,
                                "select": "item",
                                "database": "3d33c906597f80c79db3c475c853e59a"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 900,
                                    "y": 300
                                }
                            }
                        },
                        {
                            "id": 8,
                            "module": "google-email:ActionSendEmail",
                            "version": 1,
                            "parameters": {
                                "account": 10331435
                            },
                            "mapper": {
                                "cc": [],
                                "to": [
                                    "{{7.properties_value.`Correo electrónico`}}"
                                ],
                                "bcc": [],
                                "from": "",
                                "html": "Hola {{7.properties_value.Nombre[].text.content}}!<br><br>Te compartimos una nueva publicacion de la comunidad de viajeros:<br><br>{{replace(replace(replace(1.properties_value.`Contenido Generado`[].text.content; \"\n\"; \"<br>\"); \"**\"; \"\"); \"## \"; \"\")}}<br><br>Muchas gracias.<br>Saludos,<br>Equipo Turismo",
                                "subject": "Nueva publicacion: {{1.properties_value.`Idea Semilla`[].text.content}}",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1200,
                                    "y": 300
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
